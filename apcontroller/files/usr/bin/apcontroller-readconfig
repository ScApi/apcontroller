#!/bin/sh
# Fetch configuration exclusively from a host defined in /etc/config/apcontroller.
# No arbitrary address or SSH command is accepted from the browser.
SEC=$1
case "$SEC" in
	''|*[!a-zA-Z0-9_]* ) echo "Invalid host section" >&2; exit 2 ;;
esac
[ "$(uci -q get apcontroller."$SEC")" = host ] || exit 2

IP=$(uci -q get apcontroller."$SEC".ipaddr)
PORT=$(uci -q get apcontroller."$SEC".port)
USER=$(uci -q get apcontroller."$SEC".username)
PASS=$(uci -q get apcontroller."$SEC".password)
USEKEY=$(uci -q get apcontroller."$SEC".usekeyfile)
KEYFILE=$(uci -q get apcontroller."$SEC".keyfile)
[ -n "$IP" ] && [ -n "$USER" ] || exit 2
[ -n "$PORT" ] || PORT=22
case "$PORT" in *[!0-9]*|'') exit 2 ;; esac
[ -n "$KEYFILE" ] || KEYFILE=/root/.ssh/id_dropbear

REMOTE="/tmp/apcontroller-agent-config-$$"
AGENT=/usr/share/apcontroller/apcontroller-agent-config
[ -r "$AGENT" ] || exit 3

if [ "$USEKEY" = 1 ]; then
	[ -r "$KEYFILE" ] || exit 3
	scp -q -i "$KEYFILE" -o ConnectTimeout=8 -o BatchMode=yes -o StrictHostKeyChecking=accept-new -P "$PORT" "$AGENT" "$USER@$IP:$REMOTE" || exit 4
	ssh -q -i "$KEYFILE" -o ConnectTimeout=8 -o BatchMode=yes -o StrictHostKeyChecking=accept-new -p "$PORT" "$USER@$IP" "sh $REMOTE; CODE=\$?; rm -f $REMOTE; exit \$CODE"
else
	# Keep the password out of the process argument list.
	export SSHPASS="$PASS"
	sshpass -e scp -q -o ConnectTimeout=8 -o StrictHostKeyChecking=accept-new -P "$PORT" "$AGENT" "$USER@$IP:$REMOTE" || exit 4
	sshpass -e ssh -q -o ConnectTimeout=8 -o StrictHostKeyChecking=accept-new -p "$PORT" "$USER@$IP" "sh $REMOTE; CODE=\$?; rm -f $REMOTE; exit \$CODE"
fi
