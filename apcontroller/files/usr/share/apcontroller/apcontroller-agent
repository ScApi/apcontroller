#!/bin/sh

. /lib/functions/system.sh
. /usr/share/libubox/jshn.sh

json_init
json_add_string "hostname" "$(cat /proc/sys/kernel/hostname)"
json_add_string "model" "$(cat /tmp/sysinfo/model)"
json_add_string "load" "$(awk '{printf "%s %s %s", $1, $2, $3}' /proc/loadavg)"
json_add_int "uptime" "$(awk '{printf "%d", $1}' /proc/uptime)"
MAC=$(get_mac_label)
if [ -z "${MAC}" ]; then
	grep -q br-lan /proc/net/dev && IF=br-lan || IF=eth0
	MAC=$([ -e /sys/class/net/$IF/address ] && cat /sys/class/net/$IF/address || echo "")
fi
json_add_string "mac" "${MAC}"
json_add_string "software" "$(awk -F= '/^OPENWRT_RELEASE=/ {print $2}' /etc/os-release 2>/dev/null | xargs)"

if [ -e /etc/config/wireless ]; then
	LEASEFILE=$(uci -q get dhcp.@dnsmasq[0].leasefile || echo "/tmp/dhcp.leases")
	HOSTHINTS=$(ubus call luci-rpc getHostHints 2>/dev/null || echo '{}')
	WIRELESSSTATUS=$(ubus call network.wireless status 2>/dev/null)
	for BAND in 2g 5g 6g; do
		CHANNELS=""
		IFNAMES=""
		FILTER=""
		case "$BAND" in
			"2g")
				FILTER='@.config.band="2g" || @.config.hwmode="11g"'
				;;
			"5g")
				FILTER='@.config.band="5g" || @.config.hwmode="11a"'
				;;
			"6g")
				FILTER='@.config.band="6g"'
				;;
		esac
		eval $(jsonfilter -s "$WIRELESSSTATUS" -q -e 'CHANNELS=@[@.up=true && ('"$FILTER"')].config.channel' -e 'IFNAMES=@[@.up=true && ('"$FILTER"')].interfaces[*].ifname')
		if [ -n "${CHANNELS}" ]; then
			json_add_string "channels${BAND}" "${CHANNELS}"
		fi
		if [ -n "${IFNAMES}" ]; then
			json_add_array "clientslist${BAND}"
			for IFNAME in $IFNAMES; do
				# Exclude 802.11s peers from the regular Wi-Fi client list.
				TYPE=$(iw dev "$IFNAME" info 2>/dev/null | awk '/^[[:space:]]*type /{print $2; exit}')
				[ "$TYPE" = "AP" ] || continue
				SSID=$(jsonfilter -s "$WIRELESSSTATUS" -q -e '@.*.interfaces[@.ifname="'${IFNAME}'"].config.ssid')
				if [ -z "$SSID" ]; then
					T=$(jsonfilter -s "$WIRELESSSTATUS" -q -e '@.*.interfaces[@.ifname="'${IFNAME}'"].config.mesh_id')
					[ -n "$T" ] && SSID="MESHID: $T"
				fi
				for STATION in $(iw dev "$IFNAME" station dump 2>/dev/null | awk '{if($1 == "Station") {MAC=$2; station[MAC]=1} if($0 ~ /rx bytes:/) {rx[MAC]=$3} if($0 ~ /tx bytes:/) {tx[MAC]=$3} if($0 ~ /^\s*signal:/) {signal[MAC]=$2} if($0 ~ /connected time:/) {connected[MAC]=$3}} END {for (s in station) {printf "%s,%s,%s,%d,%d ", s, rx[s], tx[s], signal[s], connected[s]}}'); do
					set -- $(echo "$STATION" | tr ',' ' ')
					_MAC="$1"
					json_add_object
					json_add_string "ssid" "$SSID"
					json_add_string "mac" "$_MAC"
					json_add_int "tx" "$2"
					json_add_int "rx" "$3"
					json_add_int "signal" "$4"
					json_add_int "connected" "$5"
					T="0"
					grep -qi "^ht supported" /sys/kernel/debug/ieee80211/*/*/stations/${_MAC}/ht_capa 2>/dev/null && T="4"
					grep -qi "^vht supported" /sys/kernel/debug/ieee80211/*/*/stations/${_MAC}/vht_capa 2>/dev/null && T="5"
					grep -qi "^he supported" /sys/kernel/debug/ieee80211/*/*/stations/${_MAC}/he_capa 2>/dev/null && T="6"
					grep -qi "^eht supported" /sys/kernel/debug/ieee80211/*/*/stations/${_MAC}/eht_capa 2>/dev/null && T="7"
					json_add_int "wifi" "$T"
					IPADDR=""
					NAME=""
					T=$(awk '/'${_MAC}'/{if($4 == "*"){$4=""};printf "%s %s", $3, $4}' $LEASEFILE)
					if [ -n "$T" ]; then
						set -- $(echo "$T")
						IPADDR="$1"
						NAME="$2"
					else
						T=$(awk '/0x[26]\s*'${_MAC}'/{printf "%s", $1; exit}' /proc/net/arp)
						IPADDR="$T"
					fi
					if [ -z "$NAME" ]; then
						T=$(jsonfilter -s "$HOSTHINTS" -q -e '@["'$(echo "$_MAC" | tr 'a-f' 'A-F')'"].name')
						[ -n "$T" ] && NAME="$T"
					fi
					json_add_string "ipaddr" "$IPADDR"
					json_add_string "name" "$NAME"
					json_close_object
				done
			done
			json_close_array
		fi
	done
fi


# 802.11s monitoring: report only peers from configured mesh interfaces.
# No wireless configuration is changed during polling.
json_add_array "meshpeers"
MESHSECTIONS=$(uci -q show wireless | awk -F[.=] '/=wifi-iface$/{print $2}')
for SEC in $MESHSECTIONS; do
	[ "$(uci -q get wireless."$SEC".mode)" = "mesh" ] || continue
	MESHID=$(uci -q get wireless."$SEC".mesh_id)
	RADIO=$(uci -q get wireless."$SEC".device)
	# ubus exposes the runtime ifname of each wifi-iface section.
	IFNAME=$(jsonfilter -s "$(ubus call network.wireless status 2>/dev/null)" -q -e '@.*.interfaces[@.section="'"$SEC"'"].ifname' | head -n 1)
	[ -n "$IFNAME" ] || continue
	iw dev "$IFNAME" station dump 2>/dev/null | awk '
		/^Station / { mac=$2; signal=""; tx=""; rx=""; }
		/^[[:space:]]*signal:/ {signal=$2}
		/^[[:space:]]*tx bitrate:/ {tx=$3}
		/^[[:space:]]*rx bitrate:/ {rx=$3}
		/^[[:space:]]*connected time:/ {
			if (mac ~ /^[0-9a-fA-F:]+$/) print mac,signal,tx,rx,$3
		}' > /tmp/apcontroller-meshpeers.$$
	while read -r PEER SIGNAL TXRATE RXRATE CONNECTED; do
		json_add_object
		json_add_string "interface" "$IFNAME"
		json_add_string "mesh_id" "$MESHID"
		json_add_string "radio" "$RADIO"
		json_add_string "mac" "$PEER"
		json_add_string "signal" "$SIGNAL"
		json_add_string "txrate" "$TXRATE"
		json_add_string "rxrate" "$RXRATE"
		json_add_string "connected" "$CONNECTED"
		json_close_object
	done < /tmp/apcontroller-meshpeers.$$
	rm -f /tmp/apcontroller-meshpeers.$$
done
json_close_array

# Read-only usteer discovery. Never expose secrets from its UCI file.
if [ -f /etc/config/usteer ]; then
	json_add_boolean "usteer_installed" 1
	if /etc/init.d/usteer enabled >/dev/null 2>&1; then
		json_add_boolean "usteer_enabled" 1
	else
		json_add_boolean "usteer_enabled" 0
	fi
	for OPTION in signal_diff min_snr roam_scan_snr roam_trigger_snr band_steering_interval load_balancing_interval; do
		VALUE=$(uci -q get usteer.@usteer[0]."$OPTION")
		case "$VALUE" in
			''|*[!0-9-]*) ;;
			*) json_add_string "usteer_$OPTION" "$VALUE" ;;
		esac
	done
else
	json_add_boolean "usteer_installed" 0
fi

json_dump

exit 0
