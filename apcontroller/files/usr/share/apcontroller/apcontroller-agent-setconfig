			uci set usteer.@usteer[0]."$OPTION"="$VALUE" || exit 9
			USTEERCHANGE=1
		done
		if [ "$USTEERCHANGE" = "1" ]; then
			cp -p /etc/config/usteer /etc/config/usteer.apcontroller.bak || exit 10
			uci commit usteer || exit 10
			/etc/init.d/usteer reload >/dev/null 2>&1 || /etc/init.d/usteer restart >/dev/null 2>&1 || exit 11
		fi
	fi
	json_select ..
fi

if [ $NEEDCOMMIT -eq 1 ]; then
	# Preserve a copy before committing changes; retain existing file permissions.
	cp -p /etc/config/wireless /etc/config/wireless.apcontroller.bak || exit 4
	uci commit wireless
	wifi reload
fi

rm "$FILE"
[ -e /tmp/apcontroller.user ] && rm /tmp/apcontroller.user
[ -e /tmp/apcontroller-agent-as ] && rm /tmp/apcontroller-agent-as

exit 0
